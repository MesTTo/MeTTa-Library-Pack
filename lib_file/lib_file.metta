; Purpose: files, directories, paths, links, traversal, scopes and streams.
; The handle half is MeTTa HE's surface exactly, with b added for bytes; the
; rest is named so it cannot be mistaken for HE's. Bytes are an expression of
; integers 0 to 255, a file's lines can be a space of (line Number Text)
; atoms, replace-file! and copy-dir! publish by one rename, dir-walk and
; dir-glob answer one path per answer, and with-file and with-temp-dir apply a
; function to a resource that closes on every exit. A missing file is an
; ERROR rather than a failure, so it can never be mistaken for an empty file.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/19-file_lib.metta; commit=e40ef941310bddd1f57074eb559e78aac8a263b0]

; The text coercions and the NUL-safe line split come from lib_string.
!(import! &self (library lib_string))

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_file/lib_file.pl")
  (append-bytes! append-file! copy-dir! copy-file! delete-dir! delete-file! delete-tree! dir-exists dir-glob dir-walk exit! file-close! file-exists file-get-size! file-kind file-lines! file-metadata! file-open! file-read-bytes! file-read-exact! file-read-to-string! file-seek! file-space! file-write! file-write-bytes! list-dir! make-dir! make-link! path-absolute path-extension path-join path-name path-normalize path-parent path-parts path-relative path-resolve path-stem read-bytes! read-file! read-link rename-file! replace-file! same-file stderr stderr! stdin stdin-to-string! stdout temp-dir! temp-path! with-file with-temp-dir write-bytes! write-file!))

(: append-bytes! (-> %Undefined% Expression Bool))
(@doc append-bytes!
  (@desc "Append an expression of integers 0 to 255 to the file at Path, creating it when absent. The bytes are validated before the file is touched.")
  (@params ((@param "Path") (@param "Bytes")))
  (@return "Done"))

(: append-file! (-> %Undefined% %Undefined% Bool))
(@doc append-file!
  (@desc "Append UTF-8 text to the file at Path, creating it when absent.")
  (@params ((@param "Path") (@param "Content")))
  (@return "Done"))

(: copy-dir! (-> %Undefined% %Undefined% Bool))
(@doc copy-dir!
  (@desc "Copy a directory tree to a new path: the contents of Source become the contents of Destination, which must not exist; missing parents of Destination are created. Regular files are copied byte for byte, symbolic links are recreated with the text they hold, and a FIFO, socket or device raises. The tree is built in a staging directory beside Destination and published with one rename, so a reader sees no tree or the whole tree, and a failure leaves nothing behind. A destination inside the source raises before anything is written. Ownership, modes and times are not copied.")
  (@params ((@param "Source") (@param "Destination")))
  (@return "Done"))

(: copy-file! (-> %Undefined% %Undefined% Bool))
(@doc copy-file!
  (@desc "Copy bytes to a destination filename with staged replacement: the copy is written beside the destination, both streams close, and one rename publishes it, so an existing destination is replaced only after the complete copy succeeds. A directory destination and copying a file onto itself are errors.")
  (@params ((@param "Source") (@param "Destination")))
  (@return "Done"))

(: delete-dir! (-> %Undefined% Bool))
(@doc delete-dir!
  (@desc "Remove an empty directory; missing or nonempty directories raise. delete-tree! removes a directory with its contents.")
  (@params ((@param "Path")))
  (@return "Done"))

(: delete-file! (-> %Undefined% Bool))
(@doc delete-file!
  (@desc "Remove a regular file; an absent file is already removed and answers True.")
  (@params ((@param "Path")))
  (@return "Done"))

(: delete-tree! (-> %Undefined% Bool))
(@doc delete-tree!
  (@desc "Remove whatever is at Path: a directory with everything under it, a file, or a symbolic link, which is unlinked without touching its target. A missing path raises.")
  (@params ((@param "Path")))
  (@return "Done"))

(: dir-exists (-> %Undefined% Bool))
(@doc dir-exists
  (@desc "True when a directory exists at the path, following links, False otherwise.")
  (@params ((@param "Path")))
  (@return "Answer"))

(: dir-glob (-> %Undefined% %Undefined% Expression String))
(: dir-glob (-> %Undefined% %Undefined% String))
(@doc dir-glob
  (@desc "Answer every path under Directory matching a relative pattern of slash-separated components, in depth-first codepoint order. A component uses the host's wildcard grammar: * and ? match within a name, [abc] and [a-c] match one character, {alt,alt} alternates, and \\ escapes the next character. The component ** matches zero or more directory levels, so \"**/*.txt\" finds every text file below Directory. A wildcard skips names beginning with a dot unless Options holds (hidden True) or the component itself begins with a dot; ** enters symbolic links only under (follow-links True) and never re-enters a directory on its chain. A literal component is looked up without listing, so a pattern without wildcards answers the path exactly when it exists. An absolute or empty pattern and a malformed component raise. Each path is answered once.")
  (@params ((@param "Directory") (@param "Pattern") (@param "Options")))
  (@return "Path"))

(: dir-walk (-> %Undefined% Expression String))
(: dir-walk (-> %Undefined% String))
(@doc dir-walk
  (@desc "Answer every descendant of a directory, one full path per answer, depth first with each directory's names in codepoint order. A symbolic link is reported and not entered unless Options holds (follow-links True); a link whose target is a directory already on the current chain is then reported and still not entered, so a cycle cannot loop. Hidden names are included. An unreadable directory raises.")
  (@params ((@param "Path") (@param "Options")))
  (@return "Entry"))

(: exit! (-> Number %Undefined%))
(@doc exit!
  (@desc "Terminate the entire process with integer status 0 through 255, including an embedding host; not an application-level return, so MeTTa catch does not turn it into a local value.")
  (@params ((@param "Status")))
  (@return "Never"))

(: file-close! (-> Number Bool))
(@doc file-close!
  (@desc "Close a handle file-open! gave. Closing twice is silent, because a cleanup path should not have to check first; a failed close raises by name, because a write that never reached the disk is data lost. The three standard streams are refused: the process owns them and a closed one cannot be put back. Not in HE's stdlib. A process that can open files and never close them leaks descriptors until it dies, so this exists.")
  (@params ((@param "Handle")))
  (@return "Done"))

(: file-exists (-> %Undefined% Bool))
(@doc file-exists
  (@desc "True when a regular file exists at the path, following links, False otherwise. No ! because it changes nothing.")
  (@params ((@param "Path")))
  (@return "Answer"))

(: file-get-size! (-> Number Number))
(@doc file-get-size!
  (@desc "Answer the size of the whole file in bytes, not of what is left to read, so seeking does not change the answer; a handle without a file name measures the stream position instead.")
  (@params ((@param "Handle")))
  (@return "Size"))

(: file-kind (-> %Undefined% Symbol))
(@doc file-kind
  (@desc "Classify the entry at Path without following it: link for a symbolic link, dangling or not; directory; file; other for an entry that exists and is none of those, such as a FIFO, socket or device; missing when nothing is observable at the path.")
  (@params ((@param "Path")))
  (@return "Kind"))

(: file-lines! (-> %Undefined% Expression))
(@doc file-lines!
  (@desc "The lines of a UTF-8 file as an expression of Strings, split on LF with one terminal empty line omitted; CR and NUL stay data. file-space! is the form that makes the lines matchable.")
  (@params ((@param "Path")))
  (@return "Lines"))

(: file-metadata! (-> %Undefined% %Undefined%))
(@doc file-metadata!
  (@desc "Snapshot kind, modified Unix time and file size as queryable atoms in a new space: (kind file|directory), (modified Seconds) and, for a file, (size Bytes). Links are followed; file-kind classifies the entry itself.")
  (@params ((@param "Path")))
  (@return "Space"))

(: file-open! (-> %Undefined% %Undefined% Number))
(@doc file-open!
  (@desc "Open a file and answer a handle. The option letters are HE's: r read, w write, c create if absent, a append, t truncate; c demands w or a, so \"rc\" is refused loudly rather than quietly opening for reading. The letter b opens the file for bytes, so file-read-bytes! and file-write-bytes! apply and the text operations refuse; without it the handle carries UTF-8 text.")
  (@params ((@param "Path") (@param "Options")))
  (@return "Handle"))

(: file-read-bytes! (-> Number Expression))
(: file-read-bytes! (-> Number Number Expression))
(@doc file-read-bytes!
  (@desc "Read the remaining bytes, or at most Count bytes, from a binary handle's cursor as an expression of integers 0 to 255. A short read at the end of the file is the answer. A text handle refuses.")
  (@params ((@param "Handle") (@param "Count")))
  (@return "Bytes"))

(: file-read-exact! (-> Number Number String))
(@doc file-read-exact!
  (@desc "Read at most Count characters from a text handle's cursor, HE's contract: a short read near the end of the file is the answer, not an error.")
  (@params ((@param "Handle") (@param "Count")))
  (@return "Content"))

(: file-read-to-string! (-> Number String))
(@doc file-read-to-string!
  (@desc "Read from the cursor to the end of a text handle as one String.")
  (@params ((@param "Handle")))
  (@return "Content"))

(: file-seek! (-> Number Number Bool))
(@doc file-seek!
  (@desc "Move the cursor to a byte offset from the start of the file, so the next read starts there; a negative position moves to the start.")
  (@params ((@param "Handle") (@param "Position")))
  (@return "Done"))

(: file-space! (-> %Undefined% %Undefined%))
(@doc file-space!
  (@desc "A file as a SPACE, the mettafied reading of reading a file: its lines become (line Number Text) atoms in a fresh space, so the file is queryable with match instead of being one long string to take apart. The line number is kept because a space is unordered, and losing which line came first would make the space strictly less useful than the string it replaced. (let $log (file-space! \"app.log\") (match $log (line $n $text) ($n $text)))")
  (@params ((@param "Path")))
  (@return "Space"))

(: file-write! (-> Number %Undefined% Bool))
(@doc file-write!
  (@desc "Write text to a text handle and flush, adding no newline.")
  (@params ((@param "Handle") (@param "Content")))
  (@return "Done"))

(: file-write-bytes! (-> Number Expression Bool))
(@doc file-write-bytes!
  (@desc "Write an expression of integers 0 to 255 to a binary handle and flush. The bytes are validated before anything is written. A text handle refuses.")
  (@params ((@param "Handle") (@param "Bytes")))
  (@return "Done"))

(: list-dir! (-> %Undefined% Expression))
(@doc list-dir!
  (@desc "The names in a directory, without . and .., as Strings sorted by codepoint. A missing directory raises.")
  (@params ((@param "Path")))
  (@return "Entries"))

(: make-dir! (-> %Undefined% Bool))
(@doc make-dir!
  (@desc "Create a directory and missing parents; an existing directory succeeds.")
  (@params ((@param "Path")))
  (@return "Done"))

(: make-link! (-> %Undefined% %Undefined% Bool))
(@doc make-link!
  (@desc "Create a symbolic link at Path holding Target exactly as written; a relative target is read relative to the link's own directory. The target need not exist. An existing entry at Path raises.")
  (@params ((@param "Target") (@param "Path")))
  (@return "Done"))

(: path-absolute (-> %Undefined% String))
(@doc path-absolute
  (@desc "Anchor a relative path to the process working directory and normalize it lexically, as CPython's posixpath.abspath does; no links are resolved.")
  (@params ((@param "Path")))
  (@return "Absolute"))

(: path-extension (-> %Undefined% String))
(@doc path-extension
  (@desc "Text after the final dot in the filename, without the dot; empty when absent. A name that is only an extension, such as .env, has extension env.")
  (@params ((@param "Path")))
  (@return "Extension"))

(: path-join (-> %Undefined% %Undefined% String))
(@doc path-join
  (@desc "Join lexical paths; an absolute second path replaces the first.")
  (@params ((@param "Directory") (@param "Name")))
  (@return "Path"))

(: path-name (-> %Undefined% String))
(@doc path-name
  (@desc "Lexical final path component.")
  (@params ((@param "Path")))
  (@return "Name"))

(: path-normalize (-> %Undefined% String))
(@doc path-normalize
  (@desc "Collapse repeated separators and dot components and resolve .. lexically, as CPython's posixpath.normpath does: \"a/./b/../c\" is \"a/c\", \"..\" stays at the start of a relative path, \"/..\" is \"/\", exactly two leading slashes are kept, and \"\" is \".\". No filesystem lookup occurs, so a .. across a symbolic link is resolved as if the link were a directory; path-resolve consults the filesystem.")
  (@params ((@param "Path")))
  (@return "Normalized"))

(: path-parent (-> %Undefined% String))
(@doc path-parent
  (@desc "Lexical parent directory; a bare filename has parent dot.")
  (@params ((@param "Path")))
  (@return "Parent"))

(: path-parts (-> %Undefined% Expression))
(@doc path-parts
  (@desc "The components of a path as an expression of Strings: \"/\" first for an absolute path, empty and dot components dropped, .. kept. \"\" answers ().")
  (@params ((@param "Path")))
  (@return "Parts"))

(: path-relative (-> %Undefined% %Undefined% String))
(@doc path-relative
  (@desc "The path from the directory Start to Path, lexically, as CPython's posixpath.relpath does: both are made absolute, the common prefix is dropped, and one .. is written per remaining component of Start; the same place is \".\". An empty Path raises.")
  (@params ((@param "Path") (@param "Start")))
  (@return "Relative"))

(: path-resolve (-> %Undefined% String))
(@doc path-resolve
  (@desc "The absolute path with every symbolic link on the way replaced by what it points to, as CPython's non-strict posixpath.realpath does: a relative path starts at the process working directory, a link's target is read before any later .. applies, a link loop or a missing component is kept as written, and the result is normalized.")
  (@params ((@param "Path")))
  (@return "Resolved"))

(: path-stem (-> %Undefined% String))
(@doc path-stem
  (@desc "The final path component without its extension, the complement of path-extension: \"a/b.tar.gz\" has stem \"b.tar\", and \".env\" has stem \"\".")
  (@params ((@param "Path")))
  (@return "Stem"))

(: read-bytes! (-> %Undefined% Expression))
(@doc read-bytes!
  (@desc "Read a whole file as an expression of integers 0 to 255. A missing file is an error rather than a failure.")
  (@params ((@param "Path")))
  (@return "Bytes"))

(: read-file! (-> %Undefined% String))
(@doc read-file!
  (@desc "Read a whole UTF-8 file as one String without the open/close dance. A missing file is an error rather than a failure, so it can never be mistaken for an empty file. Not HE's, and named so it cannot be mistaken for HE's.")
  (@params ((@param "Path")))
  (@return "Content"))

(: read-link (-> %Undefined% String))
(@doc read-link
  (@desc "The text a symbolic link holds, exactly as it was written, relative or absolute; a path that is not a link raises with its kind.")
  (@params ((@param "Path")))
  (@return "Target"))

(: rename-file! (-> %Undefined% %Undefined% Bool))
(@doc rename-file!
  (@desc "Rename a file or directory within one filesystem, the host's own rename: a file replaces an existing file and a directory replaces an existing empty directory in one step, so a reader sees the old entry or the new one. A missing source, a same-file rename, a file onto a directory, a directory onto a file or a nonempty directory, and a destination on another filesystem raise; nothing is ever copied.")
  (@params ((@param "Source") (@param "Destination")))
  (@return "Done"))

(: replace-file! (-> %Undefined% %Undefined% Bool))
(@doc replace-file!
  (@desc "Publish a new file at Path by rename: the content is written to a staging file beside the destination, closed, and renamed over Path in one step, so a reader sees the old file or the complete new one and never a partial write. A String, Symbol or Number is UTF-8 text; an expression of integers 0 to 255 is bytes. A failed write, close or rename keeps the old file.")
  (@params ((@param "Path") (@param "Content")))
  (@return "Done"))

(: same-file (-> %Undefined% %Undefined% Bool))
(@doc same-file
  (@desc "True when both paths name one physical file or directory, through links, hard links and different spellings; False when they differ or either is missing.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Answer"))

(: stderr (-> Number))
(@doc stderr
  (@desc "The handle for standard error, which is 2; (file-write! (stderr) $text) is stderr! reached through the handle surface.")
  (@params ())
  (@return "Handle"))

(: stderr! (-> %Undefined% Bool))
(@doc stderr!
  (@desc "Write text to stderr and flush, without adding a newline.")
  (@params ((@param "Content")))
  (@return "Done"))

(: stdin (-> Number))
(@doc stdin
  (@desc "The handle for standard input, which is 0; every handle operation takes it, so (file-read-to-string! (stdin)) reads standard input through EOF.")
  (@params ())
  (@return "Handle"))

(: stdin-to-string! (-> String))
(@doc stdin-to-string!
  (@desc "Consume standard input through EOF as UTF-8 text.")
  (@params ())
  (@return "Content"))

(: stdout (-> Number))
(@doc stdout
  (@desc "The handle for standard output, which is 1; (file-write! (stdout) $text) writes without a newline.")
  (@params ())
  (@return "Handle"))

(: temp-dir! (-> %Undefined% String))
(@doc temp-dir!
  (@desc "A unique fresh directory in the system temporary directory, created exclusively so concurrent runners cannot mint the same name; the caller owns it and removes it with delete-dir! or delete-tree!. The prefix names the directory and may not contain a separator.")
  (@params ((@param "Prefix")))
  (@return "Path"))

(: temp-path! (-> %Undefined% String))
(@doc temp-path!
  (@desc "A unique fresh path in the system temporary directory, created exclusively so concurrent runners cannot mint the same name; the caller owns the file from that point (write-file! truncates it, delete-file! ends it). The prefix names the file and may not contain a separator.")
  (@params ((@param "Prefix")))
  (@return "Path"))

(: with-file (-> %Undefined% %Undefined% %Undefined% %Undefined%))
(@doc with-file
  (@desc "Open Path with file-open!'s option letters, apply Function to the handle and answer every result of that application; the handle closes when the answers are exhausted, when the caller stops after one, and when the body raises. Function is a lambda, a function name or a partial application, as par-map takes. A close failure raises unless the body already raised.")
  (@params ((@param "Path") (@param "Options") (@param "Function")))
  (@return "Answer"))

(: with-temp-dir (-> %Undefined% %Undefined% %Undefined%))
(@doc with-temp-dir
  (@desc "Mint a fresh directory with temp-dir!, apply Function to its path and answer every result; the directory and everything under it are removed when the answers are exhausted, when the caller stops after one, and when the body raises. A body that already removed or renamed the directory is fine.")
  (@params ((@param "Prefix") (@param "Function")))
  (@return "Answer"))

(: write-bytes! (-> %Undefined% Expression Bool))
(@doc write-bytes!
  (@desc "Create or truncate the file at Path in place and write an expression of integers 0 to 255. The bytes are validated before the file is touched.")
  (@params ((@param "Path") (@param "Bytes")))
  (@return "Done"))

(: write-file! (-> %Undefined% %Undefined% Bool))
(@doc write-file!
  (@desc "Create or truncate the file at Path in place and write UTF-8 text. An open handle or a hard link to the file keeps seeing it; replace-file! is the form that publishes a new file by rename instead.")
  (@params ((@param "Path") (@param "Content")))
  (@return "Done"))
