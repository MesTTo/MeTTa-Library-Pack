; Purpose: the three encodings a program moves bytes through: UTF-8, hex and
; base64, each one head in and one head out.
;
; Bytes are an expression of Numbers from 0 to 255, which is lib_file's own byte
; shape, so what `read-bytes!` answers is what these heads take and what they
; answer is what `write-bytes!` writes. Text is a String throughout.
;
; `utf8-encode` is the length a wire format and a file count in: an accented letter
; is two bytes and an emoji four, where `string-length` counts one character each.
; `hex-encode` answers lower case and `hex-decode` reads either. `base64-encode`
; and `base64-decode` take the ALPHABET as an argument: `standard`, padded with `=`
; as mail and JSON carry it, or `url`, which uses `-` and `_` without padding, as a
; URL and a file name carry it.
;
; Malformed input is refused rather than repaired: bytes that are not UTF-8, hex of
; odd length or with a character outside the alphabet, and base64 the decoder
; rejects, each raise naming what was wrong.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/30-encoding_lib.metta; commit=WORKTREE]

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_encoding/lib_encoding.pl")
  (base64-decode base64-encode hex-decode hex-encode utf8-decode utf8-encode))

(: base64-decode (-> Symbol String Expression))
(@doc base64-decode
  (@desc "The bytes that base64 spells, in the named alphabet. Text the decoder rejects, which includes a character outside the alphabet and a truncated group, is refused naming the text.")
  (@params ((@param "Alphabet") (@param "Text")))
  (@return "Bytes"))

(: base64-encode (-> Symbol Expression String))
(@doc base64-encode
  (@desc "The bytes as base64 in one of the two RFC 4648 alphabets: `standard`, padded with `=` as mail and JSON carry it, or `url`, which uses `-` and `_` and no padding, as a URL and a file name carry it. An alphabet the library does not know is refused with both named.")
  (@params ((@param "Alphabet") (@param "Bytes")))
  (@return "Text"))

(: hex-decode (-> String Expression))
(@doc hex-decode
  (@desc "The bytes that hexadecimal spells, in either case. An odd number of digits or a character outside 0-9a-fA-F is refused naming it, because a truncated or mistyped dump is not bytes.")
  (@params ((@param "Text")))
  (@return "Bytes"))

(: hex-encode (-> Expression String))
(@doc hex-encode
  (@desc "The bytes as hexadecimal, two lower-case digits each and nothing between them, which is how a hash, a key and a wire dump are all written.")
  (@params ((@param "Bytes")))
  (@return "Text"))

(: utf8-decode (-> Expression String))
(@doc utf8-decode
  (@desc "The text those UTF-8 bytes spell. A byte sequence that is not UTF-8 is refused, because the alternative is a string holding whatever the bytes happened to mean.")
  (@params ((@param "Bytes")))
  (@return "Text"))

(: utf8-encode (-> String Expression))
(@doc utf8-encode
  (@desc "The UTF-8 bytes of the text, as an expression of Numbers from 0 to 255. This is the length a wire format and a file both count in: an accented letter is two bytes, an emoji four, where string-length counts one character each.")
  (@params ((@param "Text")))
  (@return "Bytes"))
; end generated Prolog face
