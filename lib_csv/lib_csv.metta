!(import_prolog_functions_from_file (library "lib_csv/lib_csv.pl")
  (csv-append! csv-encode csv-parse csv-read! csv-snapshot! csv-space csv-write!))

(: csv-append! (-> %Undefined% Expression Bool))
(: csv-append! (-> %Undefined% Expression Expression Bool))
(@doc csv-append!
  (@desc "Append field lists as one atomic file transaction and return True. Create a missing file. Validate existing CSV, retain its bytes and width, and add a terminator after a valid unterminated last record when needed. Options are csv-space's. Cost is linear in old and new bytes; batch related rows. A persistent .metta-csv.lock coordinates writers using the same path.")
  (@params ((@param "Path") (@param "Rows") (@param "Options")))
  (@return "Written"))

(: csv-encode (-> Expression Expression String))
(: csv-encode (-> Expression String))
(@doc csv-encode
  (@desc "Encode field lists as CSV. Every field must be a String. Quote and escape fields when needed, including a singleton empty field. Options are csv-space's; newline selects CRLF, LF or CR output and skip only affects reading. Empty rows encode as blank records. Empty input produces \"\".")
  (@params ((@param "Rows") (@param "Options")))
  (@return "Text"))

(: csv-parse (-> %Undefined% Expression))
(: csv-parse (-> %Undefined% Expression Expression))
(@doc csv-parse
  (@desc "Parse text into a list of field lists. Preserve empty fields, duplicates, Unicode, whitespace, NUL and quoted newlines. A blank record has zero fields; a quoted empty field has one. Options are csv-space's. Malformed records raise with their logical number; empty input produces an empty list.")
  (@params ((@param "Text") (@param "Options")))
  (@return "Rows"))

(: csv-read! (-> %Undefined% Expression))
(: csv-read! (-> %Undefined% Expression Expression))
(@doc csv-read!
  (@desc "Stream one field list per answer from a UTF-8 file, preserving order and duplicates. Options are csv-space's. Width checking precedes answer filtering. Only consumed records are validated. Exhaustion, cut and cancellation close the traversal's independent stream.")
  (@params ((@param "Path") (@param "Options")))
  (@return "Fields"))

(: csv-snapshot! (-> %Undefined% Expression SpaceType))
(: csv-snapshot! (-> %Undefined% SpaceType))
(@doc csv-snapshot!
  (@desc "Read once into a fresh mutable space of (row Number Field...) atoms. Number is the file's one-based logical record number, including skipped headers. Preserve duplicates and Strings. Options are csv-space's. Failed reads, writes, cancellation and output matching release the new space.")
  (@params ((@param "Path") (@param "Options")))
  (@return "Space"))

(: csv-space (-> %Undefined% Expression SpaceType))
(: csv-space (-> %Undefined% SpaceType))
(@doc csv-space
  (@desc "Return a live read-only space of (row Field...) atoms. Each query reopens the UTF-8 file and preserves order and duplicate rows. Fields are Strings. Options are unique (separator String), (quote String), (newline String), (width infer|any|Number), and (skip Number) expressions. Defaults are comma, double quote, CRLF, inferred width and zero skipped records. An empty quote disables quoting. Skipped records still establish and validate width. Quote literal option data, for example (quote ((quote \"\"))). The parameter evaluates, so a function may also compute and return the complete options.")
  (@params ((@param "Path") (@param "Options")))
  (@return "Space"))

(: csv-write! (-> %Undefined% Expression Bool))
(: csv-write! (-> %Undefined% Expression Expression Bool))
(@doc csv-write!
  (@desc "Atomically replace a UTF-8 CSV file with field lists and return True. Options are csv-space's; skip does not discard output. Validate Strings and widths, close staging, then publish. Failures before publication preserve the destination. A staging-cleanup error reports whether publication occurred. Writers coordinate through a persistent sibling .metta-csv.lock file.")
  (@params ((@param "Path") (@param "Rows") (@param "Options")))
  (@return "Written"))
