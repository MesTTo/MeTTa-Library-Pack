; Purpose: structured host messages, topic controls and explicit handlers.
; Guarantees: the generated face follows the Prolog declarations.
; [tested: sh check.sh prolog-face; commit=cf6b111ffad74477d9fa7169b215379dcabe721c].

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_logging/lib_logging.pl")
  (log! log-enabled log-format log-levels log-to! log-topic! log-topics))

(: log! (-> String Symbol Atom Expression))
(@doc log!
  (@desc "Send a held payload through print_message/2 when its topic is enabled. The structured host term contains (log-event Topic Level Payload). Host hooks can capture it; otherwise the host prints the diagnostic text from log-format.")
  (@params ((@param "Topic") (@param "Level") (@param "Payload")))
  (@return "Unit"))

(: log-enabled (-> String Bool))
(@doc log-enabled
  (@desc "Whether the exact topic is enabled. An unknown topic answers False without registering it. The setting is sampled once for each log! or log-to! call.")
  (@params ((@param "Topic")))
  (@return "Enabled"))

(: log-format (-> String Symbol Atom String))
(@doc log-format
  (@desc "The message's diagnostic text, whether or not its topic is enabled. It uses the engine's display syntax for the held payload, not a serialization format.")
  (@params ((@param "Topic") (@param "Level") (@param "Payload")))
  (@return "Text"))

(: log-levels (-> Expression))
(@doc log-levels
  (@desc "The supported host message levels. informational follows SWI's verbose flag; unhandled warnings and errors follow the host on_warning and on_error flags.")
  (@params ())
  (@return "Levels"))

(: log-to! (-> Atom String Symbol Atom Expression))
(@doc log-to!
  (@desc "Send through the host message mechanism with an explicit MeTTa handler. It takes an evaluated Expression (log-event Topic Level Payload) and answers True to consume or False to leave the host printer and later hooks active. The event is quoted at the call boundary to preserve its held payload; Atom-typed parameters retain that written quote by normal argument rules. Only the first verdict is used. Missing/non-Bool answers and exceptions raise. Earlier host hooks retain precedence. Disabled topics never apply Handler.")
  (@params ((@param "Handler") (@param "Topic") (@param "Level") (@param "Payload")))
  (@return "Unit"))

(: log-topic! (-> String Bool Expression))
(@doc log-topic!
  (@desc "Enable or disable this exact topic for every level. Settings are process-wide in the host debug registry under metta_log(Topic); unrelated host topics are untouched. Configured topics remain discoverable when disabled.")
  (@params ((@param "Topic") (@param "Enabled")))
  (@return "Unit"))

(: log-topics (-> Expression))
(@doc log-topics
  (@desc "A sorted snapshot of configured (log-topic Name Enabled) rows. The names are Strings and disabled topics remain in the snapshot.")
  (@params ())
  (@return "Topics"))
; end generated Prolog face
