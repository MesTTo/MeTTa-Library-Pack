; Purpose: directed graphs as expressions, with the walks and orderings over them.
;
; A graph IS a collection of (Vertex Neighbours) pairs, vertices in the standard
; order of terms and each neighbour collection a set, which is lib_pairs' multimap
; shape. Every vertex a neighbour names is itself a vertex, which is what makes a
; walk total, so `graph-of` adds the vertices its edges mention and the first
; argument is for the ISOLATED ones.
;
; `graph-vertices` answers a set, so lib_sets' operations ask about vertices;
; `graph-edges` answers a relation, so lib_pairs' operations walk the edges. An
; unknown vertex is a refusal naming it rather than an empty answer that would
; read as a sink, and a cycle refuses the topological order naming a vertex on it,
; where the host's own sort just fails.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/25-graph_lib.metta; commit=WORKTREE]

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_graph/lib_graph.pl")
  (graph-add-edges graph-add-vertices graph-closure graph-edges graph-is graph-is-acyclic graph-neighbours graph-of graph-reachable graph-remove-edges graph-remove-vertices graph-topological-order graph-transpose graph-union graph-vertices))

(: graph-add-edges (-> Expression Expression Expression))
(@doc graph-add-edges
  (@desc "The graph with those edges, and with any vertex they mention that it did not hold. An edge that is there changes nothing.")
  (@params ((@param "Graph") (@param "Edges")))
  (@return "Bigger"))

(: graph-add-vertices (-> Expression Expression Expression))
(@doc graph-add-vertices
  (@desc "The graph with those vertices, each with no neighbours unless it had some already. Adding a vertex that is there changes nothing.")
  (@params ((@param "Graph") (@param "Vertices")))
  (@return "Bigger"))

(: graph-closure (-> Expression Expression))
(@doc graph-closure
  (@desc "The transitive closure: an edge for every path of one step or more, so a vertex's neighbours in the answer are everything it can reach. A vertex on a cycle reaches itself, which is how graph-is-acyclic and the ordering's refusal find one.")
  (@params ((@param "Graph")))
  (@return "Closure"))

(: graph-edges (-> Expression Expression))
(@doc graph-edges
  (@desc "Every edge as a (From To) pair, ordered by tail and then by head. This is lib_pairs' relation shape, so the edges of a graph are a relation and its operations apply to them.")
  (@params ((@param "Graph")))
  (@return "Edges"))

(: graph-is (-> %Undefined% Bool))
(@doc graph-is
  (@desc "Whether the value is a graph: a collection of (Vertex Neighbours) pairs whose vertices are a set, whose neighbour collections are sets, and whose every neighbour is itself a vertex of the graph. That last condition is what the walks rely on, and the one a hand-written graph most often misses.")
  (@params ((@param "Value")))
  (@return "Answer"))

(: graph-is-acyclic (-> Expression Bool))
(@doc graph-is-acyclic
  (@desc "Whether the graph has no cycle, which is exactly whether it has a topological order. This is the total question beside the ordering's refusal.")
  (@params ((@param "Graph")))
  (@return "Answer"))

(: graph-neighbours (-> Expression %Undefined% Expression))
(@doc graph-neighbours
  (@desc "The vertices this one points at, as a set. A vertex the graph does not hold is a refusal naming it, because an empty answer there reads as a sink and a typo would go unnoticed.")
  (@params ((@param "Graph") (@param "Vertex")))
  (@return "Neighbours"))

(: graph-of (-> Expression Expression Expression))
(@doc graph-of
  (@desc "The graph of those edges, each written (From To), with those vertices added: every vertex an edge mentions is a vertex whether it is listed or not, so the first argument is for the ISOLATED ones. Vertices come out in the standard order of terms and each neighbour collection is a set.")
  (@params ((@param "Vertices") (@param "Edges")))
  (@return "Graph"))

(: graph-reachable (-> Expression %Undefined% Expression))
(@doc graph-reachable
  (@desc "Every vertex reachable from this one, itself included, as a set. The vertex itself is always in the answer, whether or not a path returns to it, which is the reflexive reading the host's reachable/3 takes.")
  (@params ((@param "Graph") (@param "Vertex")))
  (@return "Reachable"))

(: graph-remove-edges (-> Expression Expression Expression))
(@doc graph-remove-edges
  (@desc "The graph without those edges. The vertices stay, because removing the last edge of a vertex leaves the vertex; graph-remove-vertices is how a vertex goes.")
  (@params ((@param "Graph") (@param "Edges")))
  (@return "Smaller"))

(: graph-remove-vertices (-> Expression Expression Expression))
(@doc graph-remove-vertices
  (@desc "The graph without those vertices AND without every edge that touched one, which is what keeps the answer a graph. Removing a vertex that is not there changes nothing.")
  (@params ((@param "Graph") (@param "Vertices")))
  (@return "Smaller"))

(: graph-topological-order (-> Expression Expression))
(@doc graph-topological-order
  (@desc "The vertices in an order that puts every edge's tail before its head. A graph with a cycle has no such order, and this refuses NAMING a vertex on a cycle, where the host's top_sort/2 simply fails and a caller reads that as \"no answer\".")
  (@params ((@param "Graph")))
  (@return "Order"))

(: graph-transpose (-> Expression Expression))
(@doc graph-transpose
  (@desc "The graph with every edge reversed and the same vertices. The union of a graph and its transpose is the undirected reading of it.")
  (@params ((@param "Graph")))
  (@return "Transposed"))

(: graph-union (-> Expression Expression Expression))
(@doc graph-union
  (@desc "Every vertex and every edge of either, once.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Union"))

(: graph-vertices (-> Expression Expression))
(@doc graph-vertices
  (@desc "Every vertex, in the standard order of terms, which is a set and therefore what lib_sets' operations take: membership of a vertex is set-member over this.")
  (@params ((@param "Graph")))
  (@return "Vertices"))
; end generated Prolog face
