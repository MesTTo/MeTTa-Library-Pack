; Purpose: compose numeric construction from MeTTa streams and shared kernels.
; Guarantees: fill preserves numeric identity; random construction validates
; complete inputs before drawing and retains the core generator's draw order.
; [tested: lib_vector_surface, test_vector_seeded_construction; commit=WORKTREE].
; Owns resources: random-float consumes the caller's existing thread generator;
; with-seed owns any requested temporary seed scope.
; [tested: lib_vector_surface:random_draw_order_and_state; commit=WORKTREE].
!(import! &self (library lib_combinatorics))

(: cosine-of-normalized (-> Expression Expression Number))
(= (cosine-of-normalized $left $right) (dot $left $right))
(@doc cosine-of-normalized
  (@desc "The dot specialization used for normalized vectors, as an ordinary equation. No unit-length check: (3 4) with itself gives 25.0. Numeric and dimension errors come from dot.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Product"))

(: vector-fill (-> Number Number Expression))
(= (vector-fill $count $value)
   (let* (($count-ok (assertEqualMsg
                       (and (collections-integer? $count) (>= $count 0)) True
                       (quote (vector-fill "use a nonnegative integer count" $count))))
          ($number (assertEqualMsg (vector-scale () $value) ()
                     (quote (vector-fill "use a Number value" $value)))))
     (collapse (let $_ (range 0 $count) (quote $value)))))
(@doc vector-fill
  (@desc "Collect Count copies of Value from a MeTTa range. Count must be a nonnegative integer and Value a Number, including when Count is zero. Preserve its numeric type and signed zero. Invalid counts raise a named assertion; vector-scale supplies numeric validation.")
  (@params ((@param "Count") (@param "Value")))
  (@return "Vector"))

(: random-normal-vector (-> Number Expression))
(: random-normal-vector (-> Number Expression Expression))
(= (random-normal-vector $count) (random-normal-vector $count ()))
(= (random-normal-vector $count $accumulator)
   (let* (($count-ok (assertEqualMsg (collections-integer? $count) True
                       (quote (random-normal-vector "use an integer count" $count))))
          ($checked (collections-expression $accumulator))
          ($numbers (assertEqualMsg
                      (foldl-atom (quote $checked) True $valid $value
                        (if $valid
                          (if (is-expr $value) False (== (vector-scale () $value) ()))
                          False)) True
                      (quote (random-normal-vector "use numeric components" $accumulator))))
          ($values (foldall cons-atom
                     (let $_ (range 0 $count) (random-float 0 1))
                     (quote $accumulator))))
     (vector-normalize $values)))
(@doc random-normal-vector
  (@desc "Fold Count fresh positive uniform draws onto Accumulator with cons-atom, then normalize. The default accumulator is empty; negative integer counts draw nothing. Validate every literal component before core random-float and with-seed draws; code inside an accumulator is refused without running it. An empty accumulator projects the positive cube, neither Gaussian nor a uniform spherical direction. Count and expression errors are named assertions; numeric errors come from vector-scale.")
  (@params ((@param "Count") (@param "Accumulator")))
  (@return "Vector"))

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_vector/lib_vector.pl")
  (cosine dot norm vector-add vector-distance vector-divide vector-multiply vector-normalize vector-scale vector-subtract))

(: cosine (-> Expression Expression Number))
(@doc cosine
  (@desc "Return the cosine similarity of equal-dimensional numeric expressions. Compute the exact finite ratio before rounding, even if a norm would overflow or underflow. Zero or nonfinite vectors produce NaN.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Similarity"))

(: dot (-> Expression Expression Number))
(@doc dot
  (@desc "Return the dot product as a float. Accumulate exact finite products before one rounding; preserve IEEE infinities and NaNs. Empty inputs return 0.0. Both complete numeric expressions must have the same dimension.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Product"))

(: norm (-> Expression Number))
(@doc norm
  (@desc "Return the correctly rounded Euclidean length of a numeric expression. Exact squared sums avoid intermediate overflow and underflow. Empty inputs return 0.0; NaN propagates and infinity without NaN returns infinity.")
  (@params ((@param "Vector")))
  (@return "Length"))

(: vector-add (-> Expression Expression Expression))
(@doc vector-add
  (@desc "Add equal-dimensional numeric expressions component by component. Exact operands stay exact; a floating operand makes that result a float rounded once. Preserve IEEE signed zeros, infinities and NaNs.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Vector"))

(: vector-distance (-> Expression Expression Number))
(@doc vector-distance
  (@desc "Return the correctly rounded Euclidean distance of equal-dimensional numeric expressions. Subtract and sum squared differences exactly before the final root; preserve IEEE infinity and NaN behavior. Empty returns 0.0.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Distance"))

(: vector-divide (-> Expression Expression Expression))
(@doc vector-divide
  (@desc "Divide corresponding components. Exact operands return exact rationals; an exact zero divisor raises for the whole operation. A floating operand selects rounded floating results and IEEE zero division. Dimensions match.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Vector"))

(: vector-multiply (-> Expression Expression Expression))
(@doc vector-multiply
  (@desc "Multiply corresponding components, with vector-add's exact, floating and dimension rules. Use dot to sum the exact products before rounding.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Vector"))

(: vector-normalize (-> Expression Expression))
(@doc vector-normalize
  (@desc "Return floating coordinates in the same direction with unit length, rounding each exact finite ratio once. Keep direction when a rounded norm would overflow or underflow. Empty stays empty; zero vectors yield NaNs. An infinite norm maps finite coordinates to signed zero and infinities to NaN; a NaN norm yields NaNs. Signed zero coordinates keep their signs.")
  (@params ((@param "Vector")))
  (@return "Unit"))

(: vector-scale (-> Expression Number Expression))
(@doc vector-scale
  (@desc "Multiply every component by Factor, with vector-multiply's number rules. Validate Factor even when the vector is empty.")
  (@params ((@param "Vector") (@param "Factor")))
  (@return "Scaled"))

(: vector-subtract (-> Expression Expression Expression))
(@doc vector-subtract
  (@desc "Subtract Right from Left component by component, with vector-add's exact, floating and dimension rules.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Vector"))
; end generated Prolog face
