; Purpose: grammars as VALUES, run over text by a definite clause grammar.
;
; A grammar is an expression built from fourteen primitives and eleven
; combinators, and `grammar-parse` runs it over a string the way phrase/2 runs a
; DCG: every way the grammar matches is an answer, and a text it does not match
; is NO answer rather than an error. `grammar-parse-prefix` answers the value with
; the unread rest. The grammar argument is HELD, so its forms are read as data
; and never evaluated as calls; it is checked before any text is read, and a form
; the library does not know is refused naming it. `grammar-forms` lists the
; vocabulary and `grammar-is` asks whether a value is a grammar.
;
; A grammar refers to itself through `(ref f)`, where `f` is a function of no
; arguments answering a grammar, evaluated only when the parse reaches it; `map`
; applies a function to a value and `as` tags one, so a grammar is a parse tree
; by construction. The classes are ASCII and the locale plays no part: a Unicode
; class is `(char-if f)` over lib_unicode's `unicode-is`.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/27-parsing_lib.metta; commit=WORKTREE]

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_parsing/lib_parsing.pl")
  (grammar-forms grammar-is grammar-parse grammar-parse-prefix))

(: grammar-forms (-> Expression))
(@doc grammar-forms
  (@desc "Every form a grammar may be built from, as (Name Arity) pairs, with the arity of the variadic ones written as *. This is the vocabulary the refusal lists, published so a program can ask for it.")
  (@params ())
  (@return "Forms"))

(: grammar-is (-> %Undefined% Bool))
(@doc grammar-is
  (@desc "Whether the value is a well-formed grammar: every node a known form with its arity and every text argument a string. A ref's target is not followed, because it is a function evaluated only when the parse reaches it.")
  (@params ((@param "Value")))
  (@return "Answer"))

(: grammar-parse (-> Atom String %Undefined%))
(@doc grammar-parse
  (@desc "The value of the grammar over the WHOLE text, one answer per way it matches and no answer when it does not. The grammar is held, so its forms are read as data; it is checked before any text is read, and a form the library does not know is refused naming it.")
  (@params ((@param "Grammar") (@param "Text")))
  (@return "Value"))

(: grammar-parse-prefix (-> Atom String Expression))
(@doc grammar-parse-prefix
  (@desc "The value of the grammar over a PREFIX of the text, with the unread rest, as (Value Rest): one answer per way it matches, longest first where a repetition decides, and no answer when no prefix matches. This is phrase/3 with the remainder, and the way a text is read one construct at a time.")
  (@params ((@param "Grammar") (@param "Text")))
  (@return "Answer"))
; end generated Prolog face
