; Purpose: YAML documents as MeTTa values, in the shape lib_json already uses.
;
; A mapping becomes a SPACE of (Key Value) atoms, a sequence an expression, a
; string a String, a number a Number, the booleans True and False, and null Null.
; That is lib_json's own decision, taken here rather than invented, so one
; traversal walks both formats: `json-at` follows a path through a YAML value and
; `get-keys` and `get-value` query a YAML mapping.
;
; A key written with NO value decodes as the empty string rather than null: the
; host's reader does not distinguish `note:` from `note: ""`, where YAML 1.2 reads
; an omitted value as null, so a document that means null writes `~` or `null`.
;
; One document per call: the host's reader loads exactly one and fails on a stream
; holding more, so a multi-document stream is refused naming the marker rather
; than answered short. An unsupported tag, a duplicate key and malformed text are
; each refused, the last with the line the host reports.
;
; The library declares the `yaml` platform capability, so a build without SWI's
; yaml pack refuses it by name before it loads.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/28-yaml_lib.metta; commit=672e5be181839a8301ba70bc6ead69678f3735bd]

; lib_json holds the object shape and the path walk, and lib_file holds the file
; doors, so the two file forms below are one line each rather than a second copy
; of a publication protocol.
!(import! &self (library lib_json))
!(import! &self (library lib_file))

; `yaml-read!` is the decode over a whole file and `yaml-write!` is lib_file's
; atomic replacement over the encode, so a half-written document never appears at
; the destination.
(: yaml-read! (-> %Undefined% %Undefined%))
(= (yaml-read! $path) (yaml-decode (read-file! $path)))
(: yaml-write! (-> %Undefined% %Undefined% Bool))
(= (yaml-write! $path $value) (replace-file! $path (yaml-encode $value)))

(@doc yaml-read!
  (@desc "One YAML document read from a file, as yaml-decode answers it. The file is read whole through read-file!, so its encoding and refusals are lib_file's.")
  (@params ((@param "the path")))
  (@return "the document's value"))
(@doc yaml-write!
  (@desc "One YAML document written to a file, published atomically through replace-file!: the destination is replaced only after the whole document is written, so a reader never sees half of one.")
  (@params ((@param "the path") (@param "the value")))
  (@return "True"))

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_yaml/lib_yaml.pl")
  (yaml-decode yaml-encode))

(: yaml-decode (-> String %Undefined%))
(@doc yaml-decode
  (@desc "One YAML document as a MeTTa value: a mapping becomes a space of (Key Value) atoms, a sequence an expression, a string a String, a number a Number, the booleans True and False, and null Null. An empty document is Null, because that is what YAML says an empty document holds. A stream holding more than one document is refused naming the marker: the host's reader loads exactly one and fails on the rest, so answering the first would be answering less than the text says. An unsupported tag, a duplicate key and malformed text are each refused, the last with the line the host reports.")
  (@params ((@param "Text")))
  (@return "Value"))

(: yaml-encode (-> %Undefined% String))
(@doc yaml-encode
  (@desc "One YAML document as text: a space becomes a mapping of its (Key Value) atoms, an expression a sequence, a String a string, a Number a number, True and False the booleans and Null the null scalar. The text ends in a newline, as a YAML document does, and keys come out in the host writer's order rather than the space's.")
  (@params ((@param "Value")))
  (@return "Text"))
; end generated Prolog face
