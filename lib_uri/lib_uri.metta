(: uri-decode (-> String String))
(@doc uri-decode
  (@desc "Decode percent octets exactly once as strict UTF8. Literal plus stays plus. Malformed escapes, overlong UTF8, surrogate scalars and truncated sequences raise. Unescaped Unicode and encoded NUL survive. Decode after splitting the reference, since decoding a reserved slash or question mark changes structure.")
