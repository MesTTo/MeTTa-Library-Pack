(: uri-encode (-> Symbol String String))
(@doc uri-encode
  (@desc "Encode Unicode text as UTF8 percent octets in a context from uri-contexts. A literal percent is encoded too; encode raw data exactly once. NUL is %00.")
  (@params ((@param "Context") (@param "Text")))
  (@return "Encoded"))

(: uri-normalize (-> String String))
(@doc uri-normalize
  (@desc "Lowercase the scheme and host, decode unreserved percent bytes and uppercase other escape digits. Preserve userinfo case, reserved bytes and empty query delimiters. Remove dot segments from anchored paths; a relative path keeps its dots until uri-resolve supplies a base. No scheme-specific port or URN namespace rules are guessed, and percent bytes need not represent UTF8.")
  (@params ((@param "URI")))
  (@return "Normalized"))

(: uri-parts (-> String Expression))
(@doc uri-parts
  (@desc "Encoded String pairs in scheme/authority/path/query/fragment order. Path is always present. Other missing components have no row; (\"query\" \"\") retains the question mark. URNs have an ordinary opaque path. References use ASCII URI spelling and valid percent triples; uri-encode carries Unicode data. Authorities remain encoded text: this is not a DNS or IP address validator.")
  (@params ((@param "URI")))
  (@return "Parts"))

(: uri-query-build (-> Symbol Expression String))
(@doc uri-query-build
  (@desc "Encode String pairs in order using the native query-value safe characters. uri spells spaces %20; form spells them plus. Literal plus and pair separators are always escaped. Slash and question mark can remain within a value. Every pair gets an equals sign, including an empty key or value.")
  (@params ((@param "Style") (@param "Pairs")))
