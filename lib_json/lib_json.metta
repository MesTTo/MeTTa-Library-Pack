; Purpose: JSON documents whose objects are queryable spaces.
; Arrays are expressions; scalars keep their native types. Duplicate object
; fields remain separate answers. File and line readers return caller-owned
; objects; writers reject cycles and publish files only after successful close.

; Keep the established string-library import available to JSON consumers.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/14-reflect_lib.metta; commit=WORKTREE]
!(import! &self (library lib_string))

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_json/lib_json.pl")
  (dict-space get-keys get-value json-at json-decode json-encode json-lines-decode json-lines-encode json-lines-read! json-lines-write! json-pretty json-read! json-write!))

(: dict-space (-> Expression SpaceType))
(@doc dict-space
  (@desc "Build a fresh object space from (Key Value) pairs. Keys and values are data, including from and internal. Duplicate pairs stay distinct. Validate the whole list before allocation; failed construction releases every space it created.")
  (@params ((@param "Pairs")))
  (@return "Space"))

(: get-keys (-> SpaceType %Undefined%))
(@doc get-keys
  (@desc "Enumerate object keys in storage order, preserving duplicates. Use collapse to collect them. Non-pair atoms do not participate in this pattern query.")
  (@params ((@param "Space")))
  (@return "Key"))

(: get-value (-> SpaceType %Undefined% %Undefined%))
(@doc get-value
  (@desc "Enumerate values whose keys unify with Key. A missing key has no answers. Symbols and Strings are distinct keys, as in an ordinary space query.")
  (@params ((@param "Space") (@param "Key")))
  (@return "Value"))

(: json-at (-> %Undefined% Expression %Undefined%))
(@doc json-at
  (@desc "Follow object keys and zero-based array indexes. An empty Path returns Value. Object keys use get-value's unification and preserve duplicate alternatives. Missing keys or indexes have no answers; invalid indexes and scalar traversal raise.")
  (@params ((@param "Value") (@param "Path")))
  (@return "Found"))

(: json-decode (-> %Undefined% %Undefined%))
(@doc json-decode
  (@desc "Decode one JSON document. Objects become spaces, arrays become expressions, strings and numbers retain their types, and literals become True, False and Null. Duplicate fields remain queryable. Malformed or trailing content raises.")
  (@params ((@param "Text")))
  (@return "Value"))

(: json-encode (-> %Undefined% String))
(@doc json-encode
  (@desc "Encode one compact JSON document. Objects are spaces of (Key Value) fields; every stored atom must be a pair. Repeated aliases are valid, but cyclic objects or expressions raise cyclic_json_value. Non-finite numbers raise.")
  (@params ((@param "Value")))
  (@return "Text"))

(: json-lines-decode (-> %Undefined% %Undefined%))
(@doc json-lines-decode
  (@desc "Enumerate JSON values from LF or CRLF lines. Empty input has no records; blank lines and a BOM are errors naming the line. A final newline is optional. Returned objects remain caller-owned when enumeration advances or is cut.")
  (@params ((@param "Text")))
  (@return "Value"))

(: json-lines-encode (-> Expression String))
(@doc json-lines-encode
  (@desc "Encode each value as one compact JSON line, ending every record with LF. Empty Values returns the empty String. Validate the complete proper list; each record follows json-encode's value and error contracts.")
  (@params ((@param "Values")))
  (@return "Text"))

(: json-lines-read! (-> %Undefined% %Undefined%))
(@doc json-lines-read!
  (@desc "Stream UTF-8 JSON Lines from Path, reading at most one record ahead. Invalid bytes, JSON and blank lines raise with their line number. Close on exhaustion, cut or error; already returned object spaces remain caller-owned.")
  (@params ((@param "Path")))
  (@return "Value"))

(: json-lines-write! (-> %Undefined% Expression Bool))
(@doc json-lines-write!
  (@desc "Atomically replace Path with UTF-8 JSON Lines, serializing one record at a time. Every record ends in LF; empty Values writes an empty file. Publication and failure cleanup follow json-write!.")
  (@params ((@param "Path") (@param "Values")))
  (@return "Written"))

(: json-pretty (-> %Undefined% Number String))
(: json-pretty (-> %Undefined% String))
(@doc json-pretty
  (@desc "Format JSON with a nonnegative target column width. Zero selects compact encoding; one puts nonempty containers on multiple lines. Width is a layout target, not a truncation limit. The value and error contracts match json-encode.\n\nFormat JSON with SWI's default target width of 72 columns and two-space indentation. Short documents can remain on one line; long strings are not split.")
  (@params ((@param "Value") (@param "Width")))
  (@return "Text"))

(: json-read! (-> %Undefined% %Undefined%))
(@doc json-read!
  (@desc "Read one UTF-8 JSON file, closing it before creating object spaces. Malformed UTF-8, a BOM, invalid JSON and trailing content raise; no partial value is returned.")
  (@params ((@param "Path")))
  (@return "Value"))

(: json-write! (-> %Undefined% %Undefined% Bool))
(@doc json-write!
  (@desc "Atomically replace Path with one compact UTF-8 JSON document. Stage beside the destination and publish after close succeeds. A failed conversion, write, close or rename preserves an existing destination and removes staging.")
  (@params ((@param "Path") (@param "Value")))
  (@return "Written"))
