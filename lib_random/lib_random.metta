; Guarantees: the generated declarations match the native half; the math import
; composes the shared binary64 conversion before loading its consumer.
; [tested: sh check.sh prolog-face; commit=505b45e1d9184608c818a8a4fdba5cf6406bf3e7].
!(import! &self (library lib_math))

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_random/lib_random.pl")
  (random-choice! random-distributions random-draw! random-sample! random-shuffle!))

(: random-choice! (-> Atom %Undefined%))
(@doc random-choice!
  (@desc "Choose one occurrence uniformly from a nonempty expression. Items are held, so runnable expressions remain data; bind a computed population with let first. Equal values at different positions remain separate choices. Empty input raises.")
  (@params ((@param "Items")))
  (@return "Item"))

(: random-distributions (-> Expression))
(@doc random-distributions
  (@desc "The accepted distribution values as (random-distribution Name Parameters) rows, with parameter names as Strings. Uniform requires Low=<High; triangular requires Low=<Mode=<High. Normal/lognormal take a mean and nonnegative standard deviation; exponential a positive rate; gamma a positive shape and scale; beta two positive shapes; bernoulli a probability in [0,1]; pareto a positive shape and minimum one; weibull a positive scale and shape.")
  (@params ())
  (@return "Forms"))

(: random-draw! (-> Atom Number %Undefined%))
(@doc random-draw!
  (@desc "Stream Count samples of a held value such as (normal 0 1) or (gamma 2 3). Count is nonnegative; zero validates the distribution but yields no answers. Collapse collects the stream, while once/cut consumes only the demanded prefix. Bind computed parameters before building the held distribution value. Every parameter converts to finite binary64. Continuous results are floats; bernoulli returns Bool. Degenerate valid bounds or deviation and probabilities zero/one consume no random state. Use with-seed to replay and restore state. Numerical algorithms use native floating precision: results may round to an endpoint, underflow to zero or overflow to infinity. No cached normal spare or library generator exists; secure bytes remain lib_crypto's separate operation.")
  (@params ((@param "Distribution") (@param "Count")))
  (@return "Value"))

(: random-sample! (-> Atom Number Bool Expression))
(@doc random-sample!
  (@desc "Count ordered draws from held Items. Replacement True permits repeated positions; False chooses distinct positions, so Count cannot exceed the input length. Duplicate values can appear in either case. Count zero returns empty, even for an empty population. Validate every argument before drawing. Index the population once: O(n+k) with replacement; without replacement add the host's distinct-index selection and O(k log k) permutation.")
  (@params ((@param "Items") (@param "Count") (@param "Replacement")))
  (@return "Sample"))

(: random-shuffle! (-> Atom Expression))
(@doc random-shuffle!
  (@desc "A new permutation of the held expression, preserving every occurrence and leaving the input unchanged. Empty input returns empty. Uses the host's random-key sort, O(n log n), and the same generator as with-seed.")
  (@params ((@param "Items")))
  (@return "Shuffled"))
; end generated Prolog face
