; Purpose: compose exact number operations over the shared numeric providers.
; Guarantees: collection arithmetic, factor choices and floating conversion are
; inspectable equations; complete integer inputs are validated before reduction.
; [tested: lib_math; commit=6fa571d1b7059b610f73e9feed657711414251e5].
!(import! &self (library lib_vector))
!(import! &self (library lib_combinatorics))
!(import! &self (library "_support/math.metta"))

(: math-gcd (-> Expression Number))
(= (math-gcd $integers)
   (foldl-atom (math-integers $integers) 0 $acc $value
     (math-gcd-pair (abs-math $acc) (abs-math $value))))
(@doc math-gcd
  (@desc "The nonnegative greatest common divisor of a finite expression of integers. Empty input and all zeros give zero. Validate every integer before the Euclidean fold; signs do not affect the result.")
  (@params ((@param "Integers")))
  (@return "Divisor"))

(: math-lcm (-> Expression Number))
(= (math-lcm $integers)
   (foldl-atom (math-integers $integers) 1 $acc $value
     (if (or (== $acc 0) (== $value 0)) 0
       (abs-math (* (floor-div $acc (math-gcd ($acc $value))) $value)))))
(@doc math-lcm
  (@desc "The nonnegative least common multiple. Empty input gives one; any zero gives zero after every input has been validated. Derive the fold from math-gcd and exact integer division.")
  (@params ((@param "Integers")))
  (@return "Multiple"))

(: math-rational (-> Number Number))
(= (math-rational $value)
   (let ($numerator $denominator) (math-ratio $value)
     (math-rational $numerator $denominator)))

(: math-factor-pairs (-> Number Expression))
(= (math-factor-pairs $value)
   (let* (($checked (assertEqualMsg
                     (and (collections-integer? $value) (> $value 0)) True
                     (quote (math-factor-pairs $value))))
          (($limit $remainder) (math-integer-root 2 $value))
          ($factor (range 1 (+ $limit 1))))
     (if (== (% $value $factor) 0)
       ($factor (floor-div $value $factor)) (empty))))
(@doc math-factor-pairs
  (@desc "Stream positive (A B) factor pairs of a positive integer with A<=B, in ascending A order. A square's equal pair appears once. Derive candidates from range up to math-integer-root and retain exact divisors. Zero raises because it has infinitely many factor pairs.")
  (@params ((@param "Value")))
  (@return "Pair"))

(: math-float (-> Number Number))
(= (math-float $value) (index-atom (vector-scale ($value) 1.0) 0))
(@doc math-float
  (@desc "Convert a Number to binary64 by scaling one coordinate by 1.0. Vector supplies nearest rounding with ties to even, signed zero, subnormals, infinities and NaNs. Overflow saturates to signed infinity; underflow preserves the sign.")
  (@params ((@param "Value")))
  (@return "Float"))

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_math/lib_math.pl")
  (math-class math-integer-root math-power-mod math-ratio math-rational math-rationalize math-real math-real-functions math-sqrt))

(: math-class (-> Number Symbol))
(@doc math-class
  (@desc "The numeric species: integer, rational, or a host float class of zero, subnormal, normal, infinite or nan. Both signs of zero have class zero.")
  (@params ((@param "Value")))
  (@return "Class"))

(: math-integer-root (-> Number Number Expression))
(@doc math-integer-root
  (@desc "Exact (Root Remainder) with Root^Degree+Remainder=Value. Degree is positive. For nonnegative Value, Root is the floor of the real root. A negative Value requires odd Degree and gives negative Root and Remainder, toward zero. The host degree parameter must fit its native signed long; Value is unbounded.")
  (@params ((@param "Degree") (@param "Value")))
  (@return "RootAndRemainder"))

(: math-power-mod (-> Number Number Number Number))
(@doc math-power-mod
  (@desc "Compute Base^Exponent modulo a positive Modulus using native modular exponentiation, without constructing the full power. Exponent is nonnegative; any signed integer Base is reduced modulo Modulus before the host call.")
  (@params ((@param "Base") (@param "Exponent") (@param "Modulus")))
  (@return "Result"))

(: math-ratio (-> Number Expression))
(@doc math-ratio
  (@desc "The exact (Numerator Denominator) of a finite Number. For a float these represent its binary value, so 0.1 has a larger denominator than 1/10. Both floating zeros give (0 1). NaN and infinities raise.")
  (@params ((@param "Value")))
  (@return "Parts"))

(: math-rational (-> Number Number Number))
(@doc math-rational
  (@desc "Construct an exact reduced Number with a positive denominator. Whole results are integers. A zero denominator or host policy that approximates the exact result raises. The unary MeTTa form converts a finite Number to its exact binary rational value through math-ratio; rationalize is the approximation. Use math-ratio to recover the parts; rationals have no signed zero.")
  (@params ((@param "Numerator") (@param "Denominator")))
  (@return "Value"))

(: math-rationalize (-> Number Number))
(@doc math-rationalize
  (@desc "Preserve exact numbers and approximate finite floats within the host's floating rounding error, often with a much smaller denominator. Thus 0.1 becomes exactly 1/10. math-ratio instead preserves the exact binary value. Both zeros become integer zero; NaN and infinities raise.")
  (@params ((@param "Value")))
  (@return "Rational"))

(: math-real (-> Symbol Expression Number))
(@doc math-real
  (@desc "Apply one function listed by math-real-functions to its numeric arguments. Each argument first passes through math-float; the native function then uses the host arithmetic error policy. Empty arguments select a constant. Unknown names, wrong arities, nonnumbers and native domain errors raise.")
  (@params ((@param "Function") (@param "Arguments")))
  (@return "Result"))

(: math-real-functions (-> Expression))
(@doc math-real-functions
  (@desc "The native floating functions provided here as (math-function Name Arity) rows. Each row describes one accepted math-real call. Existing core trig, arithmetic and bit heads keep their names; factorial and binomial come from the imported combinatorics face.")
  (@params ())
  (@return "Functions"))

(: math-sqrt (-> Number Number))
(@doc math-sqrt
  (@desc "Correctly rounded floating square root of a nonnegative finite Number. Take the root before rounding, so huge or tiny exact inputs can still have representable roots. Reuse Vector's fractional-root kernel and final IEEE saturation. Preserve the sign of floating zero. A negative or nonfinite input raises.")
  (@params ((@param "Value")))
  (@return "Root"))
; end generated Prolog face
