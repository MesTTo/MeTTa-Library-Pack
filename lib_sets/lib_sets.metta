; Purpose: sets as ordered expressions, and the merge operations over them.
;
; A set IS an expression whose elements are in the standard order of terms with
; no duplicates, so `()` is the empty set, `size-atom` is the cardinality, `==`
; is equality and every collection door already works on one. `set-of` is the
; only head that sorts; every other one answers a set already, and every one
; that takes a set refuses an argument that is not one rather than merging it
; into nonsense. Membership compares terms rather than unifying, so a variable
; is not a member of a set of numbers.
;
; lib_roman's `/?\`, `\?` and `\?/` are the other trade: they take the
; comparison as an argument and work over unordered lists in quadratic time,
; where these merge two ordered sets in one pass.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/23-sets_lib.metta; commit=WORKTREE]

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_sets/lib_sets.pl")
  (set-difference set-disjoint set-insert set-intersection set-intersection-all set-is set-member set-of set-remove set-subset set-symmetric-difference set-union set-union-all))

(: set-difference (-> Expression Expression Expression))
(@doc set-difference
  (@desc "The elements of the first that the second does not hold. The order matters: this is not symmetric, and set-symmetric-difference is the one that is.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Rest"))

(: set-disjoint (-> Expression Expression Bool))
(@doc set-disjoint
  (@desc "Whether they share no element. The empty set is disjoint from everything, including itself.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Answer"))

(: set-insert (-> Expression %Undefined% Expression))
(@doc set-insert
  (@desc "The set with the element added, which is the set itself when it was already there. The input is left alone, as every operation here leaves its inputs.")
  (@params ((@param "Set") (@param "Element")))
  (@return "Bigger"))

(: set-intersection (-> Expression Expression Expression))
(@doc set-intersection
  (@desc "The elements in both, once.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Common"))

(: set-intersection-all (-> Expression Expression))
(@doc set-intersection-all
  (@desc "The elements every set in the collection holds. A collection of no sets has no intersection to speak of, so that raises rather than answering a universe it cannot name.")
  (@params ((@param "Sets")))
  (@return "Common"))

(: set-is (-> %Undefined% Bool))
(@doc set-is
  (@desc "Whether the value is a set: an expression in the standard order of terms with no duplicates. This is the question every other head asks before it merges, asked out loud.")
  (@params ((@param "Value")))
  (@return "Answer"))

(: set-member (-> Expression %Undefined% Bool))
(@doc set-member
  (@desc "Whether the element is in the set, compared as a TERM rather than unified: a variable is not a member of a set of numbers, where member/2 would bind it to the first one. The comparison is the standard order, so the search stops at the first element that is larger.")
  (@params ((@param "Set") (@param "Element")))
  (@return "Answer"))

(: set-of (-> Expression Expression))
(@doc set-of
  (@desc "The set of an expression's elements: the same elements in the standard order of terms, each once. This is the only head that sorts, because every other one answers a set already.")
  (@params ((@param "Items")))
  (@return "Set"))

(: set-remove (-> Expression %Undefined% Expression))
(@doc set-remove
  (@desc "The set without the element, which is the set itself when it was not there, so removing something absent is not an error.")
  (@params ((@param "Set") (@param "Element")))
  (@return "Smaller"))

(: set-subset (-> Expression Expression Bool))
(@doc set-subset
  (@desc "Whether every element of the first is in the second. A set is a subset of itself, and the empty set is a subset of everything.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Answer"))

(: set-symmetric-difference (-> Expression Expression Expression))
(@doc set-symmetric-difference
  (@desc "The elements exactly one of them holds, which is the union of the two differences and the same set whichever way round the arguments go.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Either"))

(: set-union (-> Expression Expression Expression))
(@doc set-union
  (@desc "Every element of either, once: one merge down both sets rather than a scan of one for each element of the other.")
  (@params ((@param "Left") (@param "Right")))
  (@return "Union"))

(: set-union-all (-> Expression Expression))
(@doc set-union-all
  (@desc "The union of a collection of sets, in one pass over all of them: the fold a caller would otherwise write, and the empty collection's union is the empty set.")
  (@params ((@param "Sets")))
  (@return "Union"))
; end generated Prolog face
