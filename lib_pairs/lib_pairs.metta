; Purpose: a collection of (Key Value) pairs read as a RELATION.
;
; A pair is a two-element expression, so a relation is an ordinary collection and
; this library adds no value type: what it owns is the operations that only make
; sense once a collection is read as pairs. lib_functional's `zip` and `unzip`
; build one and split it, and its `group-by` and `sort-by` take a key FUNCTION
; over arbitrary elements; these take the pair shape itself.
;
; Duplicates are kept everywhere, because a relation may hold one key many times:
; `pairs-group` gathers every value a key has, both orderings are stable, and
; `pairs-lookup` answers once per value. A key is compared as a term, so a
; lookup asks identity rather than unification, and an absent key has NO answer.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/24-pairs_lib.metta; commit=WORKTREE]

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_pairs/lib_pairs.pl")
  (pairs-group pairs-is pairs-keys pairs-lookup pairs-sort-by-key pairs-sort-by-value pairs-swap pairs-ungroup pairs-values))

(: pairs-group (-> Expression Expression))
(@doc pairs-group
  (@desc "The relation as a multimap: every key once, in the standard order of terms, with every value it has as (Key Values). The sort is this head's own and is stable, so the values arrive in the relation's own order; the host's group_pairs_by_key/2 groups only ADJACENT pairs and answers a key twice for an unsorted relation, which is why this one sorts first.")
  (@params ((@param "Pairs")))
  (@return "Groups"))

(: pairs-is (-> %Undefined% Bool))
(@doc pairs-is
  (@desc "Whether the value is a relation: a collection whose every element is a two-element expression. This is the question every other head asks before it walks one, asked out loud.")
  (@params ((@param "Value")))
  (@return "Answer"))

(: pairs-keys (-> Expression Expression))
(@doc pairs-keys
  (@desc "The key of every pair, in order and with duplicates kept, so the length is the relation's own. unzip answers both sides at once; this is the one projection.")
  (@params ((@param "Pairs")))
  (@return "Keys"))

(: pairs-lookup (-> Expression %Undefined% %Undefined%))
(@doc pairs-lookup
  (@desc "Every value the key has, one answer each, in the relation's own order. A key the relation does not hold has no answer, which is what makes a lookup composable with collapse and with an if over one; the key is compared as a TERM, so a variable matches nothing.")
  (@params ((@param "Pairs") (@param "Key")))
  (@return "Value"))

(: pairs-sort-by-key (-> Expression Expression))
(@doc pairs-sort-by-key
  (@desc "The relation ordered by key in the standard order of terms, STABLY: pairs with equal keys keep their relative order, and none is dropped.")
  (@params ((@param "Pairs")))
  (@return "Sorted"))

(: pairs-sort-by-value (-> Expression Expression))
(@doc pairs-sort-by-value
  (@desc "The relation ordered by value in the standard order of terms, STABLY. This is the other half of the same question, and it is a sort of the converse rather than a second algorithm.")
  (@params ((@param "Pairs")))
  (@return "Sorted"))

(: pairs-swap (-> Expression Expression))
(@doc pairs-swap
  (@desc "The converse relation with the order kept: every (Key Value) becomes (Value Key) where it stands. pairs-sort-by-key over the answer is the sorted converse, which is what transposing a relation usually means.")
  (@params ((@param "Pairs")))
  (@return "Swapped"))

(: pairs-ungroup (-> Expression Expression))
(@doc pairs-ungroup
  (@desc "The relation a multimap holds: one (Key Value) per value, keys in the multimap's order and values in each group's order. This inverts pairs-group, and a group whose values are not a collection raises.")
  (@params ((@param "Groups")))
  (@return "Pairs"))

(: pairs-values (-> Expression Expression))
(@doc pairs-values
  (@desc "The value of every pair, in order and with duplicates kept.")
  (@params ((@param "Pairs")))
  (@return "Values"))
; end generated Prolog face
