  (@return "UUID"))

(: uuid-time! (-> String))
(@doc uuid-time!
  (@desc "Generate a version 1 identifier using the host's OSSP provider. It contains a timestamp and may expose the host's MAC address. A host without that provider raises; uuid-random! is available independently of version 1 support.")
  (@params ())
  (@return "UUID"))

(: uuid-timestamp (-> String Number))
(@doc uuid-timestamp
  (@desc "Seconds since the Unix epoch for an RFC version 1 UUID. Other layouts and versions have no answer. Malformed text raises, so absence is not a parse error.")
  (@params ((@param "UUID")))
  (@return "Timestamp"))

(: uuid-variant (-> String Symbol))
(@doc uuid-variant
  (@desc "The layout selected by the variant bits: ncs, rfc, microsoft or future. Versions 1, 3, 4 and 5 generated here use rfc; nil uses ncs.")
  (@params ((@param "UUID")))
  (@return "Variant"))

(: uuid-version (-> String Number))
(@doc uuid-version
  (@desc "The four version bits as a Number from 0 to 15. Nil has zero; a bit pattern is not evidence that the identifier was generated according to that version.")
