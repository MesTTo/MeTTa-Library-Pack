(: uuid-of-bytes (-> Expression String))
(@doc uuid-of-bytes
  (@desc "Exactly 16 byte integers as a canonical lower-case UUID String. Every 128-bit value is preserved; this conversion does not change version or variant bits.")
  (@params ((@param "Bytes")))
  (@return "UUID"))

(: uuid-random! (-> String))
(@doc uuid-random!
  (@desc "Generate a version 4 random identifier. A UUID is not a secret; use crypto-random-bytes when unpredictability is a security requirement.")
