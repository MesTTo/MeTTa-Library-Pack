; Purpose: compose UUID names, namespaces and byte fields as MeTTa equations.
; Guarantees: complete UTF8 names and every 128-bit pattern survive conversion.
; Generated versions, strict validation and timestamps use the host boundary.
; Recipes remain callable data; shape assertions identify the supplying operation.
; [tested: lib_uuid, test_uuid_python_oracles; commit=WORKTREE].

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_uuid/lib_uuid.pl")
  (uuid-is uuid-random! uuid-time! uuid-timestamp))

(: uuid-is (-> %Undefined% Bool))
(@doc uuid-is
  (@desc "Whether Text is a UUID String with exactly 8-4-4-4-12 hexadecimal digits, accepting either case. This checks representation, not uniqueness or origin. Nil and reserved version/variant bit patterns remain valid 128-bit values.")
  (@params ((@param "Text")))
  (@return "Valid"))

(: uuid-random! (-> String))
(@doc uuid-random!
  (@desc "Generate a version 4 random identifier. A UUID is not a secret; use crypto-random-bytes when unpredictability is a security requirement.")
  (@params ())
  (@return "UUID"))

(: uuid-time! (-> String))
(@doc uuid-time!
  (@desc "Generate a version 1 identifier using the host's OSSP provider. It contains a timestamp and may expose the host's MAC address. A host without that provider raises; uuid-random! is available independently of version 1 support.")
  (@params ())
  (@return "UUID"))

(: uuid-timestamp (-> String Number))
(@doc uuid-timestamp
  (@desc "Seconds since the Unix epoch for an RFC version 1 UUID. Other layouts and versions have no answer. Malformed text raises, so absence is not a parse error.")
  (@params ((@param "UUID")))
  (@return "Timestamp"))
; end generated Prolog face

!(import! &self (library lib_encoding))
!(import! &self (library lib_crypto))
!(import! &self (library lib_pairs))
!(import! &self "../_support/uuid.metta")

(: uuid-name (-> Number %Undefined% String String))
(@doc uuid-name
  (@desc "Derive a version 3 (MD5) or version 5 (SHA-1) UUID from a namespace and the complete UTF-8 name. Namespace is dns, url, oid or x500, or any UUID String. Equal inputs give equal identifiers. Empty names and embedded NULs are valid. Version 3 requires the crypto capability; these digests identify names and provide no authentication. Prefer version 5 for new name-based identifiers.")
  (@params ((@param "Version") (@param "Namespace") (@param "Name")))
  (@return "UUID"))
; Workaround: swi-uuid-name-encoding - hash complete namespace and UTF8 bytes.
; OSSP reads Latin1 and NUL-terminated names. The byte construction also admits
; arbitrary namespace UUIDs; it follows CPython's RFC algorithm.
; [source: https://github.com/python/cpython/blob/v3.14.0/Lib/uuid.py#L763-L790; commit=WORKTREE].
(= (uuid-name $version $namespace $name)
   (let* (($algorithms (collapse (pairs-lookup (quote ((3 md5) (5 sha1))) $version)))
          ($version-ok (assertEqualMsg (size-atom $algorithms) 1
                          (quote (uuid-name "choose version 3 or 5" $version))))
          ($algorithm (car-atom $algorithms))
          ($found (collapse (pairs-lookup (uuid-namespace-table) $namespace)))
          ($space (if (== $found ()) (quote $namespace) (car-atom $found)))
          ($namespace-bytes (uuid-bytes $space))
          ($name-bytes (utf8-encode $name))
          ($input (union-atom $namespace-bytes $name-bytes))
          ($hash (crypto-hash-bytes (quote $algorithm) $input)))
     (let ($a $b $c $d $e $f $version-byte $g $variant-byte (:seg $tail))
          (hex-decode (string-slice $hash 0 32))
       (let* (($v (+ (% $version-byte 16) (* $version 16)))
              ($r (+ (% $variant-byte 64) 128)))
         (uuid-of-bytes
           (union-atom (quote ($a $b $c $d $e $f $v $g $r)) (quote $tail)))))))

(: uuid-namespaces (-> Expression))
(@doc uuid-namespaces
  (@desc "The predefined namespace Symbols accepted by uuid-name. A UUID String supplies an application namespace, so identifiers can themselves name further namespaces.")
  (@params ())
  (@return "Namespaces"))
(= (uuid-namespaces) (pairs-keys (uuid-namespace-table)))

(: uuid-nil (-> String))
(@doc uuid-nil
  (@desc "The all-zero identifier, distinct from a missing answer.")
  (@params ())
  (@return "UUID"))
(= (uuid-nil) "00000000-0000-0000-0000-000000000000")

(: uuid-bytes (-> String Expression))
(@doc uuid-bytes
  (@desc "The 16 bytes of a UUID in network order. These compose with hex-encode, base64-encode and write-bytes!, which use the same byte expression.")
  (@params ((@param "UUID")))
  (@return "Bytes"))
(= (uuid-bytes $uuid)
   (let $valid (assertEqualMsg (uuid-is $uuid) True
                 (quote (uuid-bytes "use a UUID String" $uuid)))
     (hex-decode (string-replace $uuid "-" ""))))

(: uuid-of-bytes (-> Expression String))
(@doc uuid-of-bytes
  (@desc "Exactly 16 byte integers as a canonical lower-case UUID String. Every 128-bit value is preserved; this conversion does not change version or variant bits.")
  (@params ((@param "Bytes")))
  (@return "UUID"))
(= (uuid-of-bytes $input)
   (let* (($bytes (encoding-bytes uuid-of-bytes $input))
          ($layout (uuid-layout))
          ($digits (foldl-atom $layout 0 $sum $width (+ $sum $width)))
          ($size (assertEqualMsg (* 2 (size-atom $bytes)) $digits
                    (quote (uuid-of-bytes "use exactly 16 bytes" $input))))
          ($hex (encoding-hex-text $bytes))
          ($state (foldl-atom $layout (quote (0 ())) $state $width
                    (let ($offset $pieces) $state
                      (let* (($next (+ $offset $width))
                             ($piece (string-slice $hex $offset $next))
                             ($parts (cons-atom $piece $pieces)))
                        (quote ($next $parts)))))))
     (string-join "-" (reverse (index-atom $state 1)))))

(: uuid-version (-> String Number))
(@doc uuid-version
  (@desc "The four version bits as a Number from 0 to 15. Nil has zero; a bit pattern is not evidence that the identifier was generated according to that version.")
  (@params ((@param "UUID")))
  (@return "Version"))
(= (uuid-version $uuid) (floor-div (index-atom (uuid-bytes $uuid) 6) 16))

(: uuid-variant (-> String Symbol))
(@doc uuid-variant
  (@desc "The layout selected by the variant bits: ncs, rfc, microsoft or future. Versions 1, 3, 4 and 5 generated here use rfc; nil uses ncs.")
  (@params ((@param "UUID")))
  (@return "Variant"))
(= (uuid-variant $uuid)
   (let $byte (index-atom (uuid-bytes $uuid) 8)
     (if (< $byte 128) (quote ncs)
       (if (< $byte 192) (quote rfc)
         (if (< $byte 224) (quote microsoft) (quote future))))))
