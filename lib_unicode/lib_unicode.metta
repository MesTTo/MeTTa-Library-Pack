; Purpose: the Unicode character database and the standard text transformations
; over it.
;
; Every answer comes from the host's own database, which is utf8proc's, so
; `unicode-version` is a head: a normalization is reproducible only beside the
; version that produced it. One head per QUESTION with the variant as an
; argument, so the five normalization forms, the thirteen properties and the
; fourteen character classes are three heads, and each refusal lists the names it
; knows. The classes are the database's general categories and never the process
; locale, so a letter is a letter under LC_ALL=C too.
;
; Case FOLDING is not lowercasing. It maps text to whatever compares equal
; regardless of case, so German sharp s becomes two letters and the answer can be
; longer than the input; lib_string's `string-lower` is the lowercasing.
; Graphemes are the user-perceived characters of UAX#29, so a base character with
; its combining marks is ONE answer where `string-chars` answers each code point.
;
; The library declares the `unicode` platform capability, so a build without
; SWI's utf8proc pack refuses it by name before it loads.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/26-unicode_lib.metta; commit=a30e0a59e8e16d15705dc0258d7e0a004ae63e4b]

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_unicode/lib_unicode.pl")
  (unicode-casefold unicode-codepoint-valid unicode-graphemes unicode-is unicode-map unicode-normalize unicode-property unicode-version))

(: unicode-casefold (-> String String))
(@doc unicode-casefold
  (@desc "The text case-folded for caseless comparison, which is NOT a lowercasing: it maps to whatever compares equal regardless of case, so German sharp s becomes two letters and the answer may be longer than the input. lib_string's string-lower is the lowercasing.")
  (@params ((@param "Text")))
  (@return "Folded"))

(: unicode-codepoint-valid (-> Number Bool))
(@doc unicode-codepoint-valid
  (@desc "Whether the database ASSIGNS this number a character: in range, not a surrogate half, and not unassigned or a noncharacter. It is stricter than \"a scalar value\": U+D7FF and U+10FFFF are in range and are not surrogates, and both are unassigned, so both answer False, while a private-use code point is assigned and answers True. The same question through the database is whether unicode-property answers a category at all [measured 2026-09-12: unicode_codepoint_valid/1 answers false for 55295, 65534 and 1114111, each of which has no category, and true for 57344, whose category is Co].")
  (@params ((@param "Code")))
  (@return "Answer"))

(: unicode-graphemes (-> String Expression))
(@doc unicode-graphemes
  (@desc "The user-perceived characters of UAX#29, one string each: a base character with its combining marks is ONE answer, where string-chars answers a code point each. This is the length a person counts and the boundary a cursor moves over.")
  (@params ((@param "Text")))
  (@return "Graphemes"))

(: unicode-is (-> %Undefined% Symbol Bool))
(@doc unicode-is
  (@desc "Whether the character belongs to a class the Unicode database defines: letter, upper, lower, title, digit, number, mark, punctuation, symbol, separator, white-space, control, ascii or assigned. Each is a general category or a group of them, white-space is the standard's own White_Space list, and ascii is the range; none of them consults the process locale, which is what code_type/2 does and why it is not the mechanism here. This is the question a lexer asks per character, a Bool rather than a failure so it composes with if, and an unknown class is refused with the names listed.")
  (@params ((@param "Character") (@param "Class")))
  (@return "Answer"))

(: unicode-map (-> String Expression String))
(@doc unicode-map
  (@desc "The text transformed by a collection of flags in ONE pass, which is the general operation the normalizations and the fold are compositions of: stable, compat, compose, decompose, ignore, rejectna, nlf2ls, nlf2ps, nlf2lf, stripcc, casefold, charbound, lump and stripmark. Stripping accents is (compose stripmark); normalising typographic quotes and dashes to ASCII is (lump). An unknown flag is refused with the fourteen listed, and so are the two combinations the host refuses with nothing but a domain error: compose together with decompose, which asks for both directions at once, and stripmark without either, which has no form to strip marks from.")
  (@params ((@param "Text") (@param "Flags")))
  (@return "Mapped"))

(: unicode-normalize (-> Symbol String String))
(@doc unicode-normalize
  (@desc "The text in one of the five standard forms: nfc and nfd are the canonical composition and decomposition of UAX#15, nfkc and nfkd their compatibility counterparts, and nfkc-casefold the caseless identifier form of UAX#31. Each is one composition of unicode-map's flags, named; an unknown form is refused with the five listed.")
  (@params ((@param "Form") (@param "Text")))
  (@return "Normalized"))

(: unicode-property (-> %Undefined% Symbol %Undefined%))
(@doc unicode-property
  (@desc "What the database says about one character: its general category, combining class, bidi class and mirroring, compatibility decomposition type, default ignorability, grapheme boundary class, display width, East-Asian ambiguity, its three single-character case mappings and its Indic conjunct break. A property the character has no value for has NO answer, which is data about the character; an unknown property name is refused, which is a mistake in the program. A case mapping answers the code point, because the mapping is defined on code points and not every one has a single-character mapping.")
  (@params ((@param "Character") (@param "Property")))
  (@return "Value"))

(: unicode-version (-> String))
(@doc unicode-version
  (@desc "The version of the Unicode database every other answer here comes from. A normalization is reproducible only beside the version that produced it, which is why this is a head rather than a comment.")
  (@params ())
  (@return "Version"))
; end generated Prolog face
