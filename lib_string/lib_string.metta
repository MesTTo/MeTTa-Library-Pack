(@doc string-slice
  (@desc "Return the half-open codepoint interval [From,To). Clamp each endpoint to the input; negative starts and reversed or beyond-end intervals are safe.")
  (@params ((@param "Value") (@param "From") (@param "To")))
  (@return "Out"))

