; Purpose: the environment, the working directory and what the host says about
; itself, as data a program can read and write.
;
; An environment variable's name and value are Strings, and the whole environment is
; a relation of (Name Value) pairs, which is lib_pairs' shape: String names are also
; what keeps that relation inert, where a Symbol named like a function would be
; evaluated where the relation is written.
;
; A variable that is not set has NO answer rather than an empty String, because unset
; and empty are different states. `platform-info` takes the KEY as an argument and
; `platform-keys` lists them, so a typo is a refusal rather than an absent platform.
;
; There is no shell here. Nothing in this library hands text to a shell to
; interpret; lib_process runs an executable with an argument vector, which is the
; difference between running a program and letting a string become one.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/31-system_lib.metta; commit=WORKTREE]

; begin generated Prolog face
; GENERATED by extensions/python/tools/prologface.py --write from lib/*/*.pl, tests/data/prologface/*.pl, extensions/python/tools/prologface_source.pl: the prolog-face artifact in extensions/python/tools/artifacts.py, whose prolog-face lane refuses drift.
!(import! &self (library lib_import))
!(import_prolog_functions_from_file (library "lib_system/lib_system.pl")
  (change-directory! env-all env-get env-set! env-unset! platform-info platform-keys working-directory))

(: change-directory! (-> String Bool))
(@doc change-directory!
  (@desc "Change the process's current directory. This is process-wide, like the environment: every space and every later relative path sees it. A path that is not a directory raises, naming it.")
  (@params ((@param "Path")))
  (@return "Done"))

(: env-all (-> Expression))
(@doc env-all
  (@desc "The whole environment as a relation of (Name Value) pairs, names and values both Strings, in the order the host reports. This is lib_pairs' shape, so pairs-lookup and pairs-sort-by-key answer over it.")
  (@params ())
  (@return "Variables"))

(: env-get (-> String String))
(@doc env-get
  (@desc "One environment variable's value, with NO answer when it is not set: unset and empty are different states, and a program that defaults one has to be able to tell. A collapse over this is the presence test, and if-empty over the collapse is the default.")
  (@params ((@param "Name")))
  (@return "Value"))

(: env-set! (-> String String Bool))
(@doc env-set!
  (@desc "Set the variable for this PROCESS: every space sees it and so does every child process started afterwards. Answers True, because a set that failed raises.")
  (@params ((@param "Name") (@param "Value")))
  (@return "Done"))

(: env-unset! (-> String Bool))
(@doc env-unset!
  (@desc "Remove the variable from this process. Removing one that is not set is silent, because a cleanup path should not have to check first.")
  (@params ((@param "Name")))
  (@return "Done"))

(: platform-info (-> Symbol %Undefined%))
(@doc platform-info
  (@desc "What the host says about itself: the architecture, the operating-system family, the SWI-Prolog version as a String and as its three numbers, this process's identifier, how many cores the host reports, whether integers are bounded, and the executable and home directory of the running system. The host NAME is not among them: gethostname/1 is library(socket)'s, and a whole network library is too much to link for one string. A key the library does not know is refused with every key listed, because a typo would otherwise read as a platform that does not have it.")
  (@params ((@param "Key")))
  (@return "Value"))

(: platform-keys (-> Expression))
(@doc platform-keys
  (@desc "Every key platform-info answers for, as data: the same list its refusal names.")
  (@params ())
  (@return "Keys"))

(: working-directory (-> String))
(@doc working-directory
  (@desc "The process's current directory, as an absolute path with no trailing separator. Every relative path a program writes is read against this one.")
  (@params ())
  (@return "Path"))
; end generated Prolog face
